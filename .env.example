# ---------------------------------------------------------------------------
# A) Running with Docker Compose:  copy this file to ".env" and fill in the values.
#    ".env" is git-ignored. NEVER commit real values.
# ---------------------------------------------------------------------------
SQL_SA_PASSWORD=<strong password for the database, 12+ chars with upper, lower, digit and symbol>
JWT_KEY=<random string, at least 32 characters>
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<strong password>

# ---------------------------------------------------------------------------
# B) Running the API on its own (a server or cloud host): set these as environment variables / secrets.
#    ASP.NET Core maps "__" to ":" (Jwt__Key == Jwt:Key).
# ---------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# Jwt__Key=<random string, at least 32 characters>
# Jwt__Issuer=hospital-api
# Jwt__Audience=hospital-web
# ConnectionStrings__Default=Server=<host>;Database=HospitalDb;User Id=<least-privilege-user>;Password=<password>;Encrypt=True;TrustServerCertificate=False
# Cors__Origins=https://<your-frontend-domain>
# AllowedHosts=<your-api-domain>
# Only for the very first start, then remove Admin__Password:
# Admin__Email=<admin email>
# Admin__Password=<strong password>

# ---------------------------------------------------------------------------
# C) Running the automated tests against a SQL Server (optional; defaults to local SQL Express):
#    the connection string WITHOUT a Database= part. The tests create and delete their own database.
# ---------------------------------------------------------------------------
# TEST_SQL_CONNECTION=Server=localhost;User Id=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True
